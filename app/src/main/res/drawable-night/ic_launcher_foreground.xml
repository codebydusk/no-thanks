<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground — night mode.
  Same prohibition sign, brighter badge (#E5F0FF) + deeper slash/ring (#000E24)
  for maximum contrast against the near-black #000E24 background.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Badge circle (brighter in dark mode) -->
    <path
        android:fillColor="#E5F0FF"
        android:pathData="M54,18 A36,36 0 0 1 54,90 A36,36 0 0 1 54,18 Z"/>

    <!-- Prohibition ring -->
    <path
        android:fillColor="#000E24"
        android:fillType="evenOdd"
        android:pathData="
            M54,22 A32,32 0 0 1 54,86 A32,32 0 0 1 54,22 Z
            M54,34 A20,20 0 0 1 54,74 A20,20 0 0 1 54,34 Z
        "/>

    <!-- Diagonal slash -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="45">
        <path
            android:fillColor="#000E24"
            android:pathData="M49,20 H59 V88 H49 Z"/>
    </group>

</vector>
