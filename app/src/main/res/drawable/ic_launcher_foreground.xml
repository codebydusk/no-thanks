<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground — redesigned from scratch.

  CONCEPT: A filled light-blue circle. The letters "N" and "O" are transparent
  "holes" punched through the circle using evenOdd fill. The background layer
  (dark navy) shows through the holes, creating crisp dark letters on a light badge.

  Letter safe-zone: all paths sit within a radius of ~32dp from center (54,54),
  comfortably inside the Android 66dp safe zone (33dp radius). The badge circle
  itself has radius 36 — it will be visible through any launcher mask shape.

  Works on BOTH light (#0052CC) and dark (#001433) background layers with no
  night-mode variant needed: the circle is always light, the holes always dark.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      Single evenOdd path:
        Subpath 1 — badge circle (radius 36, centre 54,54)
        Subpath 2 — N left bar       (hole)
        Subpath 3 — N diagonal       (hole)
        Subpath 4 — N right bar      (hole)
        Subpath 5 — O outer rect     (hole — the ring area)
        Subpath 6 — O inner rect     (counter-hole — restores fill inside O)

      Result:
        • Circle is filled with #CCE0FF
        • N bar shapes and O ring area are transparent (background shows through)
        • O centre is filled (same light colour as circle)
    -->
    <path
        android:fillColor="#CCE0FF"
        android:fillType="evenOdd"
        android:pathData="
            M54,18 A36,36 0 0 1 54,90 A36,36 0 0 1 54,18 Z
            M31,32 H38 V76 H31 Z
            M38,32 H44 L51,76 H45 Z
            M45,32 H53 V76 H45 Z
            M57,32 H77 V76 H57 Z
            M63,38 H71 V70 H63 Z
        "/>

</vector>