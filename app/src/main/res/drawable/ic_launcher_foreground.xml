<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground — prohibition sign (🚫) design.

  CONCEPT: A light-blue badge circle. On top: a dark navy "no-entry" ring (thick
  donut) with a diagonal slash bar — universally recognisable as "NO" without any
  text. The symbol is drawn in solid navy so it pops on the navy background.

  All content is within ~35dp of centre (54,54), safely inside every launcher
  mask shape (Android safe zone = 33dp radius from centre).

  Ring: outer r=32, inner r=20, stroke=12dp (bold, legible at small sizes)
  Slash: 10dp wide bar, rotated 45° clockwise (upper-left → lower-right direction)
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1. Light-blue badge circle (radius 36, the "border" of the badge) -->
    <path
        android:fillColor="#CCE0FF"
        android:pathData="M54,18 A36,36 0 0 1 54,90 A36,36 0 0 1 54,18 Z"/>

    <!-- 2. Navy prohibition ring: evenOdd donut (outer r=32, inner r=20) -->
    <path
        android:fillColor="#002966"
        android:fillType="evenOdd"
        android:pathData="
            M54,22 A32,32 0 0 1 54,86 A32,32 0 0 1 54,22 Z
            M54,34 A20,20 0 0 1 54,74 A20,20 0 0 1 54,34 Z
        "/>

    <!-- 3. Navy diagonal slash bar (10dp wide, 68dp tall, rotated 45° clockwise) -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="45">
        <path
            android:fillColor="#002966"
            android:pathData="M49,20 H59 V88 H49 Z"/>
    </group>

</vector>