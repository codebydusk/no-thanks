<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings page logo — self-contained flat VectorDrawable.
  Same circle-badge+evenOdd design as the adaptive icon.
  Background: rounded square in Digital Blue 800 (#002966)
  Badge: Digital Blue 100 (#CCE0FF) with NO holes punched through
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Rounded background square -->
    <path
        android:fillColor="#FF002966"
        android:pathData="M18,0 H90 Q108,0 108,18 V90 Q108,108 90,108 H18 Q0,108 0,90 V18 Q0,0 18,0 Z"/>

    <!-- Circle badge with NO punch-through holes -->
    <path
        android:fillColor="#CCE0FF"
        android:fillType="evenOdd"
        android:pathData="
            M54,18 A36,36 0 0 1 54,90 A36,36 0 0 1 54,18 Z
            M31,32 H38 V76 H31 Z
            M38,32 H44 L51,76 H45 Z
            M45,32 H53 V76 H45 Z
            M57,32 H77 V76 H57 Z
            M63,38 H71 V70 H63 Z
        "/>

</vector>
